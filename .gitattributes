
# ==========================================================
# ShieldPHP - Git Attributes
# ==========================================================

# ----------------------------------------------------------
# DEFAULT TEXT FILES
# ----------------------------------------------------------

* text=auto

# ----------------------------------------------------------
# PHP
# ----------------------------------------------------------

*.php text eol=lf diff=php
*.phtml text eol=lf diff=php
*.php.inc text eol=lf diff=php

# ----------------------------------------------------------
# CONFIGURATION FILES
# ----------------------------------------------------------

*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.example text eol=lf
*.conf text eol=lf

# ----------------------------------------------------------
# WEB FILES
# ----------------------------------------------------------

*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# ----------------------------------------------------------
# DOCUMENTATION
# ----------------------------------------------------------

*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf
*.adoc text eol=lf

# ----------------------------------------------------------
# SCRIPTS
# ----------------------------------------------------------

*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------

*.sql text eol=lf

# ----------------------------------------------------------
# BUILD AND PACKAGE FILES
# ----------------------------------------------------------

*.lock text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ----------------------------------------------------------
# BINARY FILES
# ----------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary

# ----------------------------------------------------------
# GIT DIFF SETTINGS
# ----------------------------------------------------------

*.php diff=php
*.md diff
*.json diff
*.yml diff
*.yaml diff
*.xml diff
