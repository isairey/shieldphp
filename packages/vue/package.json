{
  "name": "shieldphp-vue",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 integration package for ShieldPHP authentication and authorization.",
  "keywords": [
    "shieldphp",
    "vue",
    "vue3",
    "authentication",
    "authorization",
    "jwt",
    "oauth2",
    "sessions",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/isairey/shieldphp.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch --format esm,cjs --external vue --external vue-router --external axios",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue --external vue-router --external axios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "axios": "^1.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue": "^3.0.0",
    "vue-router": "^4.6.4"
  }
}
