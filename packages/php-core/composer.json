{
  "name": "shieldphp/core",
  "description": "Librería modular de seguridad para PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-sodium": "*"
  },
  "autoload": {
    "psr-4": {
      "ShieldPHP\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ShieldPHP\\Core\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src --level=5"
  }
}